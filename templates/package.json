{
  "name": "course-forge-presentation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "extract-narrations": "bun scripts/extract-narrations.ts",
    "synthesize-audio": "bash scripts/synthesize-audio.sh",
    "compress-audio": "bash scripts/compress-audio.sh",
    "subtitle-timing": "python3 scripts/subtitle-timing.py",
    "regenerate-course-json": "python3 scripts/regenerate-course-json.py",
    "lint": "python3 scripts/lint-course.py",
    "record": "bun scripts/record.js"
  },
  "dependencies": {
    "animejs": "4.4.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "playwright": "1.51.0",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  }
}
